{
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/((en|jsonformatter|jsonxml|base64|urlcodec|uuid|jwt|regex|markdown)(/.*)?)",
      "destination": "/index.html"
    }
  ]
}
